    {
     "call": "build.redactLogLine",
     "args": {
      "line": "Cook finished: 412 packages, errors=0",
      "state": {
       "inPrivateKey": false
      }
     },
     "expect": {
      "line": "Cook finished: 412 packages, errors=0",
      "state": {
       "inPrivateKey": false
      }
     }
    },
    {
     "call": "build.redactLogLine",
     "args": {
