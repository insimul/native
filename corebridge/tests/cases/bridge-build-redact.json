   "name": "build.redactLogLine without state: an assignment, a credential in a line, a kept line, a header and a body line",
   "steps": [
    {
     "call": "build.redactLogLine",
     "args": {
      "line": "TOKEN=abc123"
     },
     "expect": {
      "line": "TOKEN=<credential>"
     }
    },
    {
     "call": "build.redactLogLine",
     "args": {
      "line": "export SERVICE_URL=\"mongodb+srv://cluster0.example.invalid/insimul\""
     },
     "expect": {
      "line": "export SERVICE_URL=<credential>"
     }
    },
    {
     "call": "build.redactLogLine",
     "args": {
      "line": "Fetching with Authorization: Bearer fakefakefakefake0123456789abcdef ok"
     },
     "expect": {
      "line": "Fetching with Authorization: <credential> ok"
     }
    },
    {
     "call": "build.redactLogLine",
     "args": {
      "line": "Cook finished: 412 packages, errors=0"
     },
     "expect": {
      "line": "Cook finished: 412 packages, errors=0"
     }
    },
    {
     "call": "build.redactLogLine",
     "args": {
      "line": "key: -----BEGIN FAKE PRIVATE KEY-----"
     },
     "expect": {
      "line": "<credential>"
     }
    },
    {
     "call": "build.redactLogLine",
     "args": {
      "line": "MIIEvfakefakefakefake"
     },
     "expect": {
      "line": "MIIEvfakefakefakefake"
     }
    },
    {
     "call": "build.redactLogLine",
     "args": {
      "line": ""
     },
     "expect": {
      "line": ""
     }
    }
   ]
  },
  {
   "name": "build.redactLogLine carries a private-key block header to footer when the state is sent back, as build.redactLog does",
   "steps": [
    {
     "call": "build.redactLogLine",
     "args": {
      "line": "writing signing key",
      "state": {
       "inPrivateKey": false
      }
     },
     "expect": {
      "line": "writing signing key",
      "state": {
       "inPrivateKey": false
      }
     },
     "bind": "s0"
    },
    {
     "call": "build.redactLogLine",
     "args": {
      "line": "-----BEGIN FAKE PRIVATE KEY-----",
      "state": {
       "$ref": "s0.state"
      }
     },
     "expect": {
      "line": "<credential>",
      "state": {
       "inPrivateKey": true
      }
     },
     "bind": "s1"
    },
    {
     "call": "build.redactLogLine",
     "args": {
      "line": "MIIEvfakefakefakefake",
      "state": {
       "$ref": "s1.state"
      }
     },
     "expect": {
      "line": "<credential>",
      "state": {
       "inPrivateKey": true
      }
     },
     "bind": "s2"
    },
    {
     "call": "build.redactLogLine",
     "args": {
      "line": "fakefakefake==",
      "state": {
       "$ref": "s2.state"
      }
     },
     "expect": {
      "line": "<credential>",
      "state": {
       "inPrivateKey": true
      }
     },
     "bind": "s3"
    },
    {
     "call": "build.redactLogLine",
     "args": {
      "line": "-----END FAKE PRIVATE KEY-----",
      "state": {
       "$ref": "s3.state"
      }
     },
     "expect": {
      "line": "<credential>",
      "state": {
       "inPrivateKey": false
      }
     },
     "bind": "s4"
    },
    {
     "call": "build.redactLogLine",
     "args": {
      "line": "done",
      "state": {
       "$ref": "s4.state"
      }
     },
     "expect": {
      "line": "done",
      "state": {
       "inPrivateKey": false
      }
     },
     "bind": "s5"
    },
    {
     "call": "build.redactLog",
     "args": {
      "log": [
       "writing signing key",
       "-----BEGIN FAKE PRIVATE KEY-----",
       "MIIEvfakefakefakefake",
       "fakefakefake==",
       "-----END FAKE PRIVATE KEY-----",
       "done"
      ]
     },
     "expect": {
      "log": [
       "writing signing key",
       "<credential>",
       "<credential>",
       "<credential>",
       "<credential>",
       "done"
      ]
     }
    }
   ]
  },
