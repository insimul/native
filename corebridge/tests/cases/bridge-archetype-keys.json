{
 "area": "archetypes",
 "description": "Hand cases for the archetypes.* rows (PL.native-archetype-key-rows): core's archetype key grammar in src/archetypes/taxonomy.ts — parseArchetypeKey, matchArchetypeKey and archetypeSpecificity — which no core conformance corpus pins (core tests them only in __tests__/taxonomy.test.ts and the genre-pieces corpus test). Every branch: well-formed keys and patterns, every null parse, wildcard and plain patterns, a string prefix that is not a segment boundary, malformed sides and a wildcard query, -1 against the per-segment scores 2N and 2N-1 (the least match scores 1; nothing scores 0), Unreal's six stated values, a binding layer's ranking, and the [invalid-input] boundary. Every expectation is computed by core's own functions at the pin (gen-bridge-archetype-key-cases.mts, kept with the builder's record).",
 "cases": [
  {
   "name": "archetypes.parseArchetypeKey: well-formed keys and patterns — segments, root and raw; a trailing .* stripped and marked; _ and - joiners; digits after the first letter, and a joined part that starts with a digit; a root outside the five still parses",
   "steps": [
    {
     "call": "archetypes.parseArchetypeKey",
     "args": {
      "key": "building.commercial.bakery.medium"
     },
     "expect": {
      "parsed": {
       "raw": "building.commercial.bakery.medium",
       "segments": [
        "building",
        "commercial",
        "bakery",
        "medium"
       ],
       "isWildcard": false,
       "root": "building"
      }
     }
    },
    {
     "call": "archetypes.parseArchetypeKey",
     "args": {
      "key": "npc"
     },
     "expect": {
      "parsed": {
       "raw": "npc",
       "segments": [
        "npc"
       ],
       "isWildcard": false,
       "root": "npc"
      }
     }
    },
    {
     "call": "archetypes.parseArchetypeKey",
     "args": {
      "key": "building.commercial.*"
     },
     "expect": {
      "parsed": {
       "raw": "building.commercial.*",
       "segments": [
        "building",
        "commercial"
       ],
       "isWildcard": true,
       "root": "building"
      }
     }
    },
    {
     "call": "archetypes.parseArchetypeKey",
     "args": {
      "key": "npc.*"
     },
     "expect": {
      "parsed": {
       "raw": "npc.*",
       "segments": [
        "npc"
       ],
       "isWildcard": true,
       "root": "npc"
      }
     }
    },
    {
     "call": "archetypes.parseArchetypeKey",
     "args": {
      "key": "prop.market_stall.two-story"
     },
     "expect": {
      "parsed": {
       "raw": "prop.market_stall.two-story",
       "segments": [
        "prop",
        "market_stall",
        "two-story"
       ],
       "isWildcard": false,
       "root": "prop"
      }
     }
    },
    {
     "call": "archetypes.parseArchetypeKey",
     "args": {
      "key": "prop.a1.b2c3"
     },
     "expect": {
      "parsed": {
       "raw": "prop.a1.b2c3",
       "segments": [
        "prop",
        "a1",
        "b2c3"
       ],
       "isWildcard": false,
       "root": "prop"
      }
     }
    },
    {
     "call": "archetypes.parseArchetypeKey",
     "args": {
      "key": "prop.level-2"
     },
     "expect": {
      "parsed": {
       "raw": "prop.level-2",
       "segments": [
        "prop",
        "level-2"
       ],
       "isWildcard": false,
       "root": "prop"
      }
     }
    },
    {
     "call": "archetypes.parseArchetypeKey",
     "args": {
      "key": "castle.keep"
     },
     "expect": {
      "parsed": {
       "raw": "castle.keep",
       "segments": [
        "castle",
        "keep"
       ],
       "isWildcard": false,
       "root": "castle"
      }
     }
    }
   ]
