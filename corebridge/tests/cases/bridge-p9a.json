  {
   "name": "mechanics.run: a fighting world's first swing lands unmetered; its stamina step is absent",
   "steps": [
    {
     "call": "mechanics.run",
     "args": {
      "ir": {
       "meta": {
        "genreConfig": {
         "id": "fighting"
        }
       },
       "routines": {
        "routines": [
         {
          "id": "herding",
          "name": "Herding",
          "blocks": [
           {
            "id": "pasture",
            "goal": "tend_flock",
            "startHour": 6,
            "endHour": 12,
            "place": "ford",
            "priority": 55
           }
          ]
         }
        ]
       }
      },
      "seed": 7,
      "steps": [
       {
        "op": "stamina.register",
        "id": "hero",
        "max": 24
       },
       {
        "op": "combat.register",
        "id": "hero",
        "health": 30,
        "maxHealth": 30
       },
       {
        "op": "combat.register",
        "id": "wolf",
        "health": 20,
        "maxHealth": 20
       },
       {
        "op": "combat.attack",
        "attackerId": "hero",
        "targetId": "wolf",
        "action": {
         "id": "heavy_swing",
         "damage": 6,
         "staminaCost": 4
        },
        "tick": 1
       }
      ]
     },
     "expect": {
      "plan": {
       "genre": "fighting",
       "known": true,
       "layers": {
        "stamina": false,
        "combat": true,
        "detection": false,
        "traversal": false,
        "locomotion": false,
        "routines": false,
        "skills": false
       },
       "shared": {
        "eventBus": [
         "combat"
        ],
        "staminaSpenders": [],
        "locomotionGraph": null
       },
       "notAssembled": []
      },
      "steps": [
       {
        "absent": true
       },
       {
        "absent": false,
        "outcome": {
         "health": 30
        },
        "stamina": null
       },
       {
        "absent": false,
        "outcome": {
         "health": 20
        },
        "stamina": null
       },
       {
        "absent": false,
        "outcome": {
         "outcome": "hit",
         "reason": null,
         "staminaCost": 4,
         "staminaSpent": 4,
         "damage": 6,
         "targetHealthAfter": 14
        },
        "stamina": null
       }
      ],
      "events": [
       "combat_action"
      ]
     }
    }
   ]
  },
