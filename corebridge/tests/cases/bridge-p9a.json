{
 "area": "p9a",
 "description": "Hand-written: the P9a rows' own contract (P9a.native, U84) — the op each row passes to core's corpus runner, a domain refusal as a VALUE, and the row's own refusals as errors with a code ([unknown-op], [invalid-input]) as a host reads them in last_error. Core's own corpora (conformance/ui/genre-hud-cases.json, conformance/ui/rules-panel-cases.json, conformance/modules/mechanic-runtime.json) are run whole by the genre_hud_corpus, rules_panel_corpus and mechanic_runtime_corpus ctests (tests/p9a_corpus.cpp), not transcribed here.",
 "cases": [
  {
   "name": "ui.genreHud: `op` and the case input go to core's runner; a refusal is a value",
   "steps": [
    {
     "call": "ui.genreHud",
     "args": {
      "op": "config",
      "genre": "rpg"
     },
     "expect": {
      "ok": true,
      "value": {
       "layout": "action_rpg",
       "showMinimap": true,
       "showHealthBar": true,
       "showStaminaBar": true,
       "showAmmoCounter": false,
       "showCompass": true
      }
     }
    },
    {
     "call": "ui.genreHud",
     "args": {
      "op": "config",
      "genre": "mystery"
     },
     "expect": {
      "ok": false,
      "refusal": {
       "code": "unknown_genre",
       "field": "genre"
      }
     }
    },
    {
     "call": "ui.genreHud",
     "args": {
      "op": "view",
      "config": {
       "layout": "vr"
      }
     },
     "expect": {
      "ok": false,
      "refusal": {
       "code": "unknown_layout",
       "field": "config.layout"
      }
     }
    }
   ]
  },
  {
   "name": "ui.genreHud: config_of / view_of project a game's own settings in core (a world genreConfig or a recipe on its world); refusals are values",
   "steps": [
    {
     "call": "ui.genreHud",
     "args": {
      "op": "config_of",
      "genreConfig": {
       "id": "rpg",
       "uiLayout": "action_rpg",
       "cameraMode": "fighting",
       "showMinimap": true
      }
     },
     "expect": {
      "ok": true,
      "value": {
       "layout": "fighting",
       "showMinimap": true
      }
     }
    },
    {
     "call": "ui.genreHud",
     "args": {
      "op": "config_of",
      "genreConfig": {
       "id": "mystery",
       "uiLayout": "puzzle",
       "showCompass": false
      }
     },
     "expect": {
      "ok": true,
      "value": {
       "layout": "puzzle",
       "showCompass": false
      }
     }
    },
    {
     "call": "ui.genreHud",
     "args": {
      "op": "config_of",
      "recipe": "strategy",
      "world": {
       "meta": {
        "genreConfig": {
         "id": "rpg",
         "uiLayout": "action_rpg",
         "cameraMode": "fighting",
         "showMinimap": true
        }
       }
      }
     },
     "expect": {
      "ok": true,
      "value": {
       "layout": "rts",
       "showMinimap": true,
       "showHealthBar": false,
       "showStaminaBar": false,
       "showAmmoCounter": false,
       "showCompass": false
      }
     }
    },
    {
     "call": "ui.genreHud",
     "args": {
      "op": "config_of",
      "recipe": "rpg-adventure",
      "world": {
       "meta": {
        "genreConfig": {
         "id": "rpg",
         "uiLayout": "action_rpg",
         "cameraMode": "fighting",
         "showMinimap": true
        }
       }
      }
     },
     "expect": {
      "ok": true,
      "value": {
       "layout": "fighting",
       "showMinimap": true
      }
     }
    },
    {
     "call": "ui.genreHud",
     "args": {
      "op": "view_of",
      "genreConfig": {
       "id": "rpg",
       "uiLayout": "action_rpg",
       "showStaminaBar": true
      },
      "state": {
       "stamina": 0.25
      }
     },
     "expect": {
      "ok": true,
      "value": {
       "layout": "action_rpg",
       "chrome": {
        "minimap": false,
        "healthBar": false,
        "staminaBar": true,
        "ammoCounter": false,
        "compass": false
       },
       "elements": [
        {
         "id": "stamina",
         "kind": "meter",
         "label": "Stamina",
         "text": "",
         "fraction": 0.25,
         "tone": "success"
        }
       ]
      }
     }
    },
    {
     "call": "ui.genreHud",
     "args": {
      "op": "view_of",
      "genreConfig": {
       "id": "rpg",
       "showMinimap": true
      }
     },
     "expect": {
      "ok": false,
      "refusal": {
       "code": "unknown_layout",
       "field": "genreConfig.uiLayout"
      }
     }
    },
    {
     "call": "ui.genreHud",
     "args": {
      "op": "config_of",
      "genreConfig": "rpg"
     },
     "expect": {
      "ok": false,
      "refusal": {
       "code": "not_a_genre_config",
       "field": "genreConfig"
      }
     }
    },
    {
     "call": "ui.genreHud",
     "args": {
      "op": "config_of",
      "recipe": "racing"
     },
     "expect": {
      "ok": false,
      "refusal": {
       "code": "unresolved_recipe",
       "field": "recipe",
       "reason": "unknown-recipe"
      }
     }
    },
    {
     "call": "ui.genreHud",
     "args": {
      "op": "view_of"
     },
     "expect": {
      "ok": false,
      "refusal": {
       "code": "no_genre_source",
       "field": "genreConfig"
      }
     }
    }
   ]
  },
