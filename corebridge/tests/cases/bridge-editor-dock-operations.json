  {
   "name": "editor.dockOperations.request: core's refusals are VALUES, each code with its message and received, in core's order",
   "steps": [
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "mintPlayGrant"
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "missing-path-parameter",
       "message": "mintPlayGrant addresses one world: /api/v1/worlds/{worldId}/play-grants needs a worldId",
       "received": "no worldId"
      }
     }
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "rereadReferenceTexts",
      "worldId": ""
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "missing-path-parameter",
       "message": "rereadReferenceTexts addresses one world: /api/v1/worlds/{worldId}/reference-texts/reread needs a worldId",
       "received": "an empty worldId"
      }
     }
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "getEntityNeighbourhood",
      "worldId": "",
      "query": {
       "maxEdges": "5"
      },
      "body": [
       1
      ]
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "missing-path-parameter",
       "message": "getEntityNeighbourhood addresses one world: /api/v1/worlds/{worldId}/neighbourhood needs a worldId",
       "received": "an empty worldId"
      }
     }
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "getEntityNeighbourhood",
      "worldId": "w1",
      "query": {
       "maxEdges": "5"
      },
      "body": [
       1
      ]
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "unknown-query-parameter",
       "message": "getEntityNeighbourhood's published row names address; the contract declares nothing else",
       "received": "the query parameter \"maxEdges\""
      }
     }
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "getEntityNeighbourhood",
      "worldId": "w1"
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "missing-query-parameter",
       "message": "getEntityNeighbourhood requires the query parameter address",
       "received": "no address"
      }
     }
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "getEntityNeighbourhood",
      "worldId": "w1",
      "query": {
       "address": ""
      }
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "missing-query-parameter",
       "message": "getEntityNeighbourhood requires the query parameter address",
       "received": "an empty address"
      }
     }
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "getWorldIRSummary",
      "worldId": "w1",
      "query": {
       "engine": "Unreal"
      }
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "query-value-not-allowed",
       "message": "getWorldIRSummary's engine is one of babylon, unreal, unity, godot; the server answers anything else with a 400",
       "received": "engine \"Unreal\", which the contract does not name"
      }
     }
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "getWorldIRSummary",
      "worldId": "w1",
      "query": {
       "address": "x"
      }
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "unknown-query-parameter",
       "message": "getWorldIRSummary's published row names engine; the contract declares nothing else",
       "received": "the query parameter \"address\""
      }
     }
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "getWorldIRSummary",
      "worldId": "w1",
      "body": []
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "unexpected-body",
       "message": "getWorldIRSummary takes no request body: the contract declares none, and the dock sends no content through it",
       "received": "a JSON array of 0 item(s)"
      }
     }
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "getWorldIRSummary",
      "worldId": "w1",
      "body": "x"
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "unexpected-body",
       "message": "getWorldIRSummary takes no request body: the contract declares none, and the dock sends no content through it",
       "received": "the string \"x\""
      }
     }
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "getWorldIRSummary",
      "worldId": "w1",
      "body": true
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "unexpected-body",
       "message": "getWorldIRSummary takes no request body: the contract declares none, and the dock sends no content through it",
       "received": "the boolean true"
      }
     }
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "rereadReferenceTexts",
      "worldId": "w1",
      "body": {
       "a": 1,
       "b": 2
      }
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "unexpected-body",
       "message": "rereadReferenceTexts takes no request body: the contract declares none, and the dock sends no content through it",
       "received": "an object with \"a\", \"b\""
      }
     }
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "mintPlayGrant",
      "worldId": "w1",
      "body": [
       {
        "ttlSeconds": 60
       }
      ]
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "body-not-object",
       "message": "mintPlayGrant's body is a JSON object or nothing (the server answers 400)",
       "received": "a JSON array of 1 item(s)"
      }
     }
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "mintPlayGrant",
      "worldId": "w1",
      "body": 7
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "body-not-object",
       "message": "mintPlayGrant's body is a JSON object or nothing (the server answers 400)",
       "received": "the number 7"
      }
     }
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "mintPlayGrant",
      "worldId": "w1",
      "body": {
       "scope": "all"
      }
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "unknown-body-member",
       "message": "mintPlayGrant's body carries ttlSeconds and nothing else",
       "received": "the body member \"scope\""
      }
     }
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "mintPlayGrant",
      "worldId": "w1",
      "body": {
       "ttlSeconds": 1.5
      }
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "invalid-body-member",
       "message": "mintPlayGrant's ttlSeconds is an integer",
       "received": "ttlSeconds the number 1.5"
      }
     }
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "mintPlayGrant",
      "worldId": "w1",
      "body": {
       "ttlSeconds": null
      }
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "invalid-body-member",
       "message": "mintPlayGrant's ttlSeconds is an integer",
       "received": "ttlSeconds null"
      }
     }
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "mintPlayGrant",
      "worldId": "w1",
      "body": {
       "ttlSeconds": [
        60
       ]
      }
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "invalid-body-member",
       "message": "mintPlayGrant's ttlSeconds is an integer",
       "received": "ttlSeconds a JSON array of 1 item(s)"
      }
     }
    }
   ]
  },
  {
   "name": "editor.dockOperations.request: [invalid-input] only for what core's types exclude",
   "steps": [
    {
     "call": "editor.dockOperations.request",
     "args": {
      "worldId": "w1"
     },
     "expectError": "[invalid-input] insimulcore: editor.dockOperations.request: `args.operationId` is missing (one of core's DOCK_OPERATION_IDS)"
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "listWorlds",
      "worldId": "w1"
     },
     "expectError": "[invalid-input] insimulcore: editor.dockOperations.request: `args.operationId` must be one of getWorldIRSummary, rereadReferenceTexts, mintPlayGrant, getEntityNeighbourhood (got \"listWorlds\")"
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": null,
      "worldId": "w1"
     },
     "expectError": "[invalid-input] insimulcore: editor.dockOperations.request: `args.operationId` must be one of getWorldIRSummary, rereadReferenceTexts, mintPlayGrant, getEntityNeighbourhood (got null)"
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "mintPlayGrant",
      "worldId": 5
     },
     "expectError": "[invalid-input] insimulcore: editor.dockOperations.request: `args.worldId` must be a string"
    },
    {
     "call": "editor.dockOperations.request",
     "args": {
      "operationId": "mintPlayGrant",
      "worldId": null
     },
     "expectError": "[invalid-input] insimulcore: editor.dockOperations.request: `args.worldId` must be a string"
