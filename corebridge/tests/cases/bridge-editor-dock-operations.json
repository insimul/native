{
 "area": "editor-dock-operations",
 "description": "Hand cases for the editor.dockOperations.* rows (PL.native-dock-operations-rows, U132; core's editor/dock-operations, PL.core-dock-operations-register): what core's four row files in conformance/editor-operations/ leave unpinned — the ids and rules rows whole, the request row's whole answer (operationId and verdict beside the method, path, query and body the corpus compares), every engine value, an empty optional query value, a null query, escaping on a POST, the mint's member at its edges, {} / null / absent as no body on all four operations, core's refusal order (world, then query, then body) and every refusal code as a value, and the [invalid-input] boundary of every member core's DockOperationInput declares. Every row answer is computed by core's own exports at the pin (gen-bridge-dock-operations-cases.mts in the item's loop record); the error strings are the row's own boundary messages.",
 "cases": [
  {
   "name": "editor.dockOperations.ids and .rules: core's DOCK_OPERATION_IDS in the register's order and DOCK_OPERATION_RULES whole",
   "steps": [
    {
     "call": "editor.dockOperations.ids",
     "args": {},
     "expect": {
      "ids": [
       "getWorldIRSummary",
       "rereadReferenceTexts",
       "mintPlayGrant",
       "getEntityNeighbourhood"
      ]
     }
    },
    {
     "call": "editor.dockOperations.rules",
     "args": {},
     "expect": {
      "rules": {
       "getWorldIRSummary": {
        "query": [
         {
          "name": "engine",
          "required": false,
          "enum": [
           "babylon",
           "unreal",
           "unity",
           "godot"
          ]
         }
        ],
        "body": "none",
        "bodyMembers": {}
       },
       "rereadReferenceTexts": {
        "query": [],
        "body": "none",
        "bodyMembers": {}
       },
       "mintPlayGrant": {
        "query": [],
        "body": "optional-object",
        "bodyMembers": {
         "ttlSeconds": "integer"
        }
       },
       "getEntityNeighbourhood": {
        "query": [
         {
          "name": "address",
          "required": true,
          "enum": null
         }
        ],
        "body": "none",
        "bodyMembers": {}
       }
      }
     }
    }
   ]
  },
