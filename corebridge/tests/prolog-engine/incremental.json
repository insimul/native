   "steps": [
    {
     "op": "consult",
     "program": ":- dynamic(skill_points/3).\n:- dynamic(skill_unlocked/2).\n:- dynamic(skill_node/2).\n:- dynamic(skill_node_cost/2).\n:- dynamic(skill_node_requires/2).\nskill_goal_met(_, Goal) :- atom(Goal), !, call(Goal).\nskill_goal_met(A, Goal) :- Goal =.. [F, _ | Rest], Bound =.. [F, A | Rest], call(Bound).\nskill_node_price(N, C) :- skill_node_cost(N, C), !.\nskill_node_price(N, 0) :- skill_node(N, _).\nskill_points_held(A, T, P) :- skill_points(A, T, P), !.\ncan_unlock(A, N) :- skill_node(N, T), \\+ skill_unlocked(A, N), skill_node_price(N, C), skill_points_held(A, T, P), P >= C, \\+ (skill_node_requires(N, G), \\+ skill_goal_met(A, G)).\nskill_node(apprentice_forge, forge_tree).\nskill_node_cost(apprentice_forge, 1).\nskill_node(guild_forge, forge_tree).\nskill_node_cost(guild_forge, 2).\nskill_node_requires(guild_forge, skill_unlocked(Actor, apprentice_forge)).\nskill_points(smith, forge_tree, 3).",
     "expect": {
      "success": true
     },
     "cost": {
      "creates": 0
     }
    },
    {
     "op": "consult",
