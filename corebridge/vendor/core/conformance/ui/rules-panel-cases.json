{
  "area": "ui-rules-panel",
  "description": "The world rules panel (P9a.core; catalog rules-world-rules-enforcement, its panel half), moved from Babylon's BabylonRulesPanel.ts: the active rules (world then base, isActive not false), highest priority first, ties in input order, each a card (type badge upper case with a tone by type, base marker, priority badge when not 5, tag line, conditions → effects summary). Runner: src/ui/rules-panel-corpus.ts. Compare exactly, object key sets included. Regenerate with npm run genre-hud-corpus; npm run genre-hud-corpus:check fails on any difference. See docs/game-genres.md §7.",
  "version": 1,
  "ops": [
    "panel",
    "card",
    "byCategory",
    "byType",
    "isActive"
  ],
  "contract": {
    "defaultPriority": 5,
    "priorityRule": "a missing or non-finite priority is 5; 0 is 0",
    "typeTones": {
      "trigger": "danger",
      "volition": "accent",
      "trait": "warning",
      "default": "success",
      "pattern": "quest",
      "other": "text_primary"
    },
    "badgeRule": "priority badge P<n> when n != 5: danger above 5, accent below",
    "emptyText": "No active rules in this world"
  },
