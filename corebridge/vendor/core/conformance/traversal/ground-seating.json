      },
      "expected": {
        "found": false,
        "heightMm": null,
        "paved": false
      }
    },
    {
      "name": "target: carried 60 mm above the mesh onto the paving",
      "op": "target",
      "input": {
        "meshMm": 0,
        "probes": [
          [
            {
              "heightMm": -20,
              "paved": false
