{
  "area": "traversal",
  "file": "traversal/ground-seating",
  "description": "Ground seating on paving (Unity's InsimulGroundSeat; src/ground-seating/ground-seat.ts), in integer mm and ms: the probe points, the drawn ground under a footprint, the carried offset and the standing height with their reasons (nothing_drawn, too_far, level, seated), and the settle from absolute instants. No slope limit or step-up here: they are the movement contract's (PLAYER_GROUND, conformance/camera/movement.json; U94(4)).",
  "catalog": [
    "traversal-ground-seating"
  ],
  "ops": [
    "tuning",
    "footprint",
    "ground",
    "target",
    "stand",
    "moved",
    "settle"
  ],
  "steps": {
    "settle": [
      "target",
      "at",
      "unseat"
    ]
  },
  "runner": "src/traversal/systems-corpus.ts (runTraversalSystemsOp). Compare exactly, object key sets included; an unknown op or step is an error.",
  "regenerate": "npm run traversal-systems-corpus; npm run traversal-systems-corpus:check fails on any difference.",
  "cases": [
    {
      "name": "tuning: Unity’s inspector defaults in mm and ms",
      "op": "tuning",
      "input": {},
      "expected": {
        "lookFromMm": 1500,
        "footprintMm": 150,
        "settleMmPerS": 1500,
        "upFactor": 4,
        "maxOffsetMm": 750,
        "reachMm": 12000,
        "levelMm": 2
      }
    },
    {
      "name": "tuning: authored numbers merge; a negative keeps the default; the up factor is at least 1",
      "op": "tuning",
      "input": {
        "params": {
          "footprintMm": 200,
          "maxOffsetMm": -5,
          "upFactor": 0,
          "settleMmPerS": 1200.9
        }
      },
      "expected": {
        "lookFromMm": 1500,
        "footprintMm": 200,
        "settleMmPerS": 1200,
        "upFactor": 1,
        "maxOffsetMm": 750,
        "reachMm": 12000,
        "levelMm": 2
      }
    },
    {
      "name": "footprint: the centre then +x, -x, +z, -z",
      "op": "footprint",
      "input": {
        "xMm": 1000,
        "zMm": -2000
      },
      "expected": {
        "points": [
          [
            1000,
            -2000
          ],
          [
            1150,
            -2000
          ],
          [
            850,
            -2000
          ],
          [
            1000,
            -1850
          ],
          [
            1000,
            -2150
          ]
        ]
      }
    },
    {
      "name": "footprint: a footprint of 0 is the centre alone",
      "op": "footprint",
      "input": {
        "xMm": 5,
        "zMm": 5,
        "params": {
          "footprintMm": 0
        }
      },
      "expected": {
        "points": [
          [
            5,
            5
          ]
        ]
      }
    },
    {
      "name": "ground: the paving over the terrain is the highest drawn surface",
      "op": "ground",
      "input": {
        "fromMm": 1500,
        "probes": [
          [
            {
              "heightMm": 0,
              "paved": false
            },
            {
              "heightMm": 60,
              "paved": true
            }
          ]
        ]
      },
      "expected": {
        "found": true,
        "heightMm": 60,
        "paved": true
      }
    },
    {
      "name": "ground: a foot on the kerb — the paving beside the centre wins",
      "op": "ground",
      "note": "Unity measured 6-9 cm in the kerb before the footprint: a body whose middle is a hair off the paving still has a foot on it.",
      "input": {
        "fromMm": 1500,
        "probes": [
          [
            {
              "heightMm": 0,
              "paved": false
            }
          ],
          [
            {
              "heightMm": 70,
              "paved": true
            }
          ],
          [
            {
              "heightMm": 0,
              "paved": false
            }
          ],
          [
            {
              "heightMm": 0,
              "paved": false
            }
          ],
          [
            {
              "heightMm": 0,
              "paved": false
            }
          ]
        ]
      },
      "expected": {
        "found": true,
        "heightMm": 70,
        "paved": true
      }
    },
    {
      "name": "ground: a tie keeps the first, so the centre’s terrain wins against equal paving beside it",
      "op": "ground",
      "input": {
        "fromMm": 1500,
        "probes": [
          [
            {
              "heightMm": 40,
              "paved": false
            }
          ],
          [
            {
              "heightMm": 40,
              "paved": true
            }
          ]
        ]
      },
      "expected": {
        "found": true,
        "heightMm": 40,
        "paved": false
      }
    },
    {
      "name": "ground: a surface above the ray’s start or past its reach does not count",
      "op": "ground",
      "input": {
        "fromMm": 1500,
        "probes": [
          [
            {
              "heightMm": 1501,
              "paved": true
            },
            {
              "heightMm": -10501,
              "paved": false
            }
          ]
        ]
      },
      "expected": {
        "found": false,
        "heightMm": null,
        "paved": false
      }
    },
    {
      "name": "ground: a surface exactly at the ray’s start counts (the top is inclusive)",
      "op": "ground",
      "note": "Unity's strip test excludes only a hit above the ray's start (h > fromY): the window is [fromMm − reachMm, fromMm], both ends inclusive.",
      "input": {
        "fromMm": 1500,
        "probes": [
          [
            {
              "heightMm": 0,
              "paved": false
            },
            {
              "heightMm": 1500,
              "paved": true
            }
          ]
        ]
      },
      "expected": {
        "found": true,
        "heightMm": 1500,
        "paved": true
      }
    },
    {
      "name": "ground: a surface exactly at the reach counts",
      "op": "ground",
      "input": {
        "fromMm": 1500,
        "probes": [
          [
            {
              "heightMm": 1501,
              "paved": true
            },
            {
              "heightMm": -10501,
              "paved": false
            },
            {
              "heightMm": -10500,
              "paved": false
            }
          ]
        ]
      },
      "expected": {
        "found": true,
        "heightMm": -10500,
        "paved": false
      }
    },
    {
      "name": "ground: nothing drawn",
      "op": "ground",
      "input": {
        "fromMm": 1500,
        "probes": [
          [],
          [],
          []
