        ]
      },
      "expected": {
        "reason": "seated",
        "wantMm": 60,
        "onPaving": true
      }
    },
    {
      "name": "target: the mesh floats above the terrain, so the body is carried below it",
      "op": "target",
      "input": {
        "meshMm": 100,
        "probes": [
          [
            {
              "heightMm": 20,
              "paved": false
            }
          ]
