      },
      "expected": {
        "reason": "seated",
        "wantMm": -80,
        "onPaving": false
      }
    },
    {
      "name": "target: exactly the believed offset is seated",
      "op": "target",
      "input": {
        "meshMm": 0,
        "probes": [
          [
            {
              "heightMm": 750,
              "paved": true
            }
          ]
        ]
      },
      "expected": {
        "reason": "seated",
        "wantMm": 750,
        "onPaving": true
      }
    },
    {
      "name": "target: a reading farther than the believed offset rides the mesh",
      "op": "target",
      "note": "A roof or a bridge deck under the ray is not where the body stands: offset 0, not on paving.",
      "input": {
        "meshMm": 0,
        "probes": [
          [
            {
              "heightMm": 751,
              "paved": true
            }
          ]
