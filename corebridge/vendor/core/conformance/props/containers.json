      "expected": {
        "view": {
          "id": "chest_1",
          "state": "open",
          "refusal": null,
          "canUnlock": false,
          "capacity": 10,
          "slotsUsed": 1,
          "slotsFree": 9,
          "full": false,
          "respawnDue": false
        }
      }
    },
