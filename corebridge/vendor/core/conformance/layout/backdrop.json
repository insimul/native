{
  "area": "layout-backdrop",
  "description": "The backdrop round a village's terrain (core src/editor/layout/backdrop.ts; the Unreal plugin's BYOA B7 r2 - r5 backdrop, characterised from the math of its spawn code, now Portable/InsimulVillageLayout). Rings of meshes stood evenly round the terrain's rectangle beyond its edge, near sides the ring's distance out, facing the middle with a +-20 degree turn and a scale jitter hashed from each one's place; frame pieces laid as four strips from the terrain's edge out to the piece's own scaled size. Brightwater Vale's 512 m terrain and the B8 project look's ring (16 meshes, 30 m out, jitter 0.3, sunk 2 m); mesh extents are nominal (the editor measures each mesh). Plan frame: IR (x, z) metres, y up; a heading points along (cos h, sin h).",
  "version": 1,
  "sources": [
    {
      "characterisedBy": "insimul-unreal tools/verify-unreal insimul_layout_characterise (Source/InsimulEditor/Tests/layout_characterise.cpp), the Portable code of unreal origin/main 6caede7 (BYOA B0-B8)",
      "ir": "$LOOPS_HOME/unreal/state/world/brightwater-ir-20261017.json",
      "irSha256": "b51cc94a9841462c10905548145cb1bce19d0dc14f75d1facdd2e367e591880d",
      "pairing": "BYOA B8 round 5 (unreal/byoa/state/byoa-b8/round-5): houses by role, the 6 m neighbour gap, the seat sinks, the 2.01 m cast, MI_Landscape_01a's layers and its ground paint",
      "world": "Brightwater Vale (6abb84ae358820954abf1ea2)"
    }
  ],
  "tolerance": 0.000001,
  "angleKeys": ["heading"],
