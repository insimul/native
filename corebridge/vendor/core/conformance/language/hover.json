            "do": "see",
            "word": "Хлеб"
          },
          {
            "do": "see",
            "word": "хлеб!"
          },
          {
            "do": "see",
            "word": "вода"
          },
          {
            "do": "mastery",
            "word": "Соль",
            "encountered": 1,
            "correct": 8
          },
          {
            "do": "see",
