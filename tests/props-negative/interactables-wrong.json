{
  "area": "props-interactables",
  "description": "NEGATIVE CONTROL for props_interactables_corpus_negative (PL.native-interact-target): a deliberately WRONG copy of core's conformance/props/interactables.json. contract.rangesM.talk is wrong, no case drives the noun op, five cases expect the answer an engine keeping one of Unreal's interim rules would give (core's deviations board-sign, fence, tiers, prop-tie and full-stop), and two hand-made cases expect what a runner that dropped a case's ranges or its lone prop would see (core's corpus has no case either would fail). One correct case of each op but noun rides beside them, so the run shows every other op driven. The runner must report every wrong one and fail.",
  "version": 1,
  "sources": [
    "tests/props-negative/interactables-wrong.json, made from corebridge/vendor/core/conformance/props/interactables.json at core 72c658c"
  ],
  "tolerance": 1e-09,
  "contract": {
    "propActions": [
      "open_board",
      "read_sign",
      "examine"
    ],
    "actions": [
      "close_panel",
      "talk",
      "pick_up",
      "open_container",
      "open_board",
      "enter",
      "read_sign",
      "examine"
    ],
    "actionTier": [
      "talk",
      "pick_up",
      "open_container",
      "open_board",
      "enter"
    ],
    "lookTier": [
      "read_sign",
      "examine"
    ],
    "notOffered": [
      "prop.structural.wall",
      "prop.structural.fence"
    ],
    "notOfferedReasons": [
      "built_fabric",
      "no_archetype"
    ],
    "signArchetypes": [
      "prop.structural.sign"
    ],
    "rangesM": {
      "talk": 3,
      "pick_up": 2.2,
      "open_container": 2.2,
      "open_board": 3.2,
      "read_sign": 2.6,
      "examine": 2.6
    },
    "doorPromptRadiusM": 2,
    "refusals": [
      "bad_position"
    ],
    "segments": "an archetype is under a key when it equals the key or starts with the key and a dot (whole dotted segments)",
    "meaning": "no archetype -> none (no_archetype); under notOffered -> none (built_fabric); the board host -> open_board, prompt \"Read the <name> notice board\" (no name: \"Read the notice board\"); under signArchetypes -> read_sign, prompt \"Read the sign\"; else examine, prompt \"Examine the <noun>\". One meaning per prop: the board host is never read as a sign; a prop.container.* prop is examined, never opened (only a ContainerIR opens)",
    "noun": "split the archetype on dots, dropping empty segments; fewer than three -> object; the fourth segment and the third (\"produce stall\") when there are four or more and the fourth is longer than one letter, else the third; underscores read as spaces",
    "text": "the prop's text trimmed; empty or absent is none",
    "host": "of the props under signArchetypes and not under notOffered, with a finite position, that do not state a settlementId other than the settlement's: the nearest to the settlement's position on the ground plane, the first listed on a tie; none -> null (no board is posted); a settlement with no finite position -> null",
    "read": "read_sign: line \"The sign reads: <text>\", or \"The sign is blank.\" with no text; events [sign_read {signId: id, objectId: id, targetText: text or '', nativeText: the same}] and nothing else (an object_examined beside it would complete the tutorial's next lesson in the same press)",
    "examine": "examine: line \"You examine the <noun>.\" or, with text, \"You examine the <noun>: <text>\" plus a full stop unless the text ends in . ! or ?; events [object_examined {objectId: id, objectName: noun, targetWord: '', targetLanguage: ''}] (no word: the language tracker records nothing, as for any untranslated object)",
    "board": "open_board: line null, events []: the board model (notice-board.json) takes over",
    "notOfferedResult": "interact on a prop with no meaning is refused not_offered (field archetype, with its reason)",
    "target": "at not a finite point -> bad_position. An open panel (a non-empty panel) -> close_panel. Else the actions tier: the villager the host would talk to (talk, \"Talk to <name or id>\"), each pick-up not taken (\"Pick up <name or id>\"), each container (\"Open the <label, ASCII A-Z folded to a-z; none: container>\"), the board host prop (\"Read the <name> notice board\"), each within its range compared with <=, and the door doorPrompt gives (outside, \"Enter <label>\"): the nearest on the ground plane wins, a tie going in actionTier order and then to the first listed. Only when no action is in range, the looking tier: each prop read or examined within its range, the nearest, the first listed on a tie. Nothing -> null. A candidate with no id or no finite position is skipped. distance is metres rounded to 1e-9; the prompt is the words after the host's key glyph",
    "ranges": "ranges overrides any of rangesM per call; a door prompts by doorPrompt alone",
    "notHere": "inside an interior (doorPrompt's exit) and a conversation in progress are the host's and not this rule's; the language world's translated objects are examineNearest's (world-words.ts)",
    "deviations": [
      {
        "id": "fence",
        "unreal": "IsOfferedProp leaves out prop.structural.wall only, so a fence panel is \"Examine the fence\"",
        "core": "prop.structural.fence is not offered either",
        "why": "pipelines states a fence panel along every front yard with room for one (settlement-dressing.ts), the same built fabric as a wall"
      },
      {
        "id": "board-sign",
        "unreal": "the board is posted on the sign nearest the settlement centre (P6) and the same sign is \"Read the sign\" (P8): one prop, two meanings",
        "core": "the board host prop means open_board only and raises no sign_read; every other sign is read",
        "why": "one key press has one meaning per prop; the board is what P6 already made E do there"
      },
      {
        "id": "tiers",
        "unreal": "P6: a pick-up, container, board or door strictly nearer than the talk villager wins, else talk; P8: talk when a villager is in range, else the nearest prop",
        "core": "one rule: the actions tier (talk, pick-up, container, board, door) by nearest, then the looking tier (sign, examine) only when no action is in range",
        "why": "the two interim rules disagree once both land; a pick-up settled 1 m from a barrel must be picked up"
      },
      {
        "id": "door-distance",
        "unreal": "PropsTargetNear considers a prompting door at the player's own location (distance 0), so it beats every other target in range",
        "core": "a door competes at doorPrompt's distance",
        "why": "the nearest rule; no Brightwater door prompts (all no_interior), so nothing live changes"
      },
      {
        "id": "prop-tie",
        "unreal": "PropToInteract keeps the LAST prop at an equal distance (D <= BestD)",
        "core": "the first listed, as doorPrompt and nearestObject do",
        "why": "one tie rule across core"
      },
      {
        "id": "segments",
        "unreal": "StartsWith on the archetype string (prop.structural.wallpaper would read as a wall; .sign anywhere hosts the board)",
        "core": "whole dotted segments: the archetype is the key or starts with the key and a dot",
        "why": "archetype keys are dotted (buildArchetypeKey); a substring is not a segment"
      },
      {
        "id": "noun",
        "unreal": "PropNoun: the third segment, or \"<fourth> <third>\" when the fourth is longer than one letter; fewer than three segments is \"object\"",
        "core": "the same, with underscores read as spaces",
        "why": "a key segment like notice_board reads \"notice board\" in a prompt"
      },
      {
        "id": "no-archetype",
        "unreal": "a stated prop with no archetype is \"Examine the object\"",
        "core": "not offered (no_archetype)",
        "why": "there is nothing to call it; pipelines states an archetype on every prop"
      },
      {
        "id": "full-stop",
        "unreal": "\"You examine the <noun>: <text>.\" always adds a full stop",
        "core": "no full stop is added after text that already ends in . ! or ?",
        "why": "a stated text with its own punctuation would read \"..\": no Brightwater text ends in one"
      },
      {
        "id": "board-settlement",
        "unreal": "the board host is chosen from every stated sign, for the first settlement only",
        "core": "a sign that states another settlementId is not considered for this settlement's board",
        "why": "a world with two settlements posts each board in its own settlement; Brightwater has one"
      }
    ]
  },
